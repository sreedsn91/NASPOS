@page
@model NasLicenseManager.Pages.Account.PasswordModel
@{ ViewData["Title"] = "Change password"; }
<div class="card narrow">
    <h1>Change password</h1>
    @if (Model.Error is not null) { <div class="alert error">@Model.Error</div> }
    <form method="post" class="stack">
        <label class="field"><span>Current password</span><input name="current" type="password" required autocomplete="current-password" /></label>
        <label class="field"><span>New password</span><input name="next" type="password" required autocomplete="new-password" /></label>
        <label class="field"><span>Confirm new password</span><input name="confirm" type="password" required autocomplete="new-password" /></label>
        <button class="btn primary" type="submit">Change password</button>
    </form>
</div>
