# Copy to .env and replace every value. Never commit .env.
SQL_ADMIN_PASSWORD=change-me-Strong#AdminPass1
SQL_APP_PASSWORD=change-me-Strong#AppPass1
DB_NAME=Kshethra
# At least 32 random bytes, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-long-random-secret-of-at-least-32-bytes
BUSINESS_UTC_OFFSET=05:30
WEB_PORT=8080
# Optional transactional SMS gateway (HTTPS GET template with {mobile} {message} {apiKey} {sender})
SMS_URL_TEMPLATE=
SMS_API_KEY=
SMS_SENDER_ID=
# Optional SMTP for e-mailing invoices and reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
